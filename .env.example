# --- Obligatoriskt ----------------------------------------------------------

# PostgreSQL. Lokalt via docker compose; i drift t.ex. Supabase eller Neon.
#
# En hostad databas kräver TLS, och drivern kopplar upp i klartext om inget
# sägs — lägg då till ?sslmode=require, annars vägrar servern anslutningen och
# varje sida svarar 500. Kör du via en pooler (Supabase port 6543, PgBouncer)
# är det poolerns adress som ska stå här, inte databasens egen.
#
#   postgresql://ANVÄNDARE:LÖSENORD@VÄRD:6543/postgres?sslmode=require
DATABASE_URL=postgresql://jobbdjungeln:jobbdjungeln@127.0.0.1:5432/jobbdjungeln

# Signerar sessioner. Byt ut den och rotera aldrig i onödan — alla loggas ut.
# Generera med: openssl rand -base64 32
AUTH_SECRET=byt-ut-mig-minst-32-tecken-langt-varde

# Publik adress, används i länkar i e-post. Ingen avslutande snedstreck.
# Måste vara https i produktion.
APP_URL=http://localhost:3000

# --- E-post -----------------------------------------------------------------
# Utan någon av dessa skrivs utgående mejl till serverloggen, vilket är precis
# vad man vill lokalt. I produktion behövs en riktig leverantör.

# Brevos HTTP-API. Föredras: SMTP-portar är blockerade hos de flesta hostar.
# BREVO_API_KEY=

# Klassisk SMTP som alternativ.
# SMTP_URL=smtp://användare:lösenord@smtp.example.test:587

EMAIL_FROM=Jobbdjungeln <no-reply@jobbdjungeln.se>

# --- Valfritt ---------------------------------------------------------------

# Google-inloggning. Knappen är dold tills båda är satta.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Delad hemlighet för de schemalagda jobben. Krävs i produktion.
# CRON_SECRET=

# Publik kontaktadress. Visas i integritetspolicyn och serveras som
# /.well-known/security.txt. Utan den ger den sökvägen 404.
# CONTACT_EMAIL=

# Peka om JobTech-anropen, t.ex. mot en mock i test.
# JOBTECH_SEARCH_URL=
# JOBTECH_AD_URL=
# JOBTECH_TAXONOMY_URL=

# Testläge: släpper på e-postverifiering och höjer taket för rate limit.
# Endast för automatiserade tester — miljöschemat vägrar starta produktion
# med den påslagen.
# AUTH_TEST_MODE=0
