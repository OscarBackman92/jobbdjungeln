{
  "name": "jobbdjungeln",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @jobbdjungeln/web test:e2e",
    "db:generate": "pnpm --filter @jobbdjungeln/db generate",
    "db:migrate": "pnpm --filter @jobbdjungeln/db migrate",
    "db:studio": "pnpm --filter @jobbdjungeln/db studio",
    "db:import-django": "pnpm --filter @jobbdjungeln/db import:django",
    "db:import-django:dry": "pnpm --filter @jobbdjungeln/db import:django:dry",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "turbo": "2.10.12",
    "typescript": "7.0.2"
  }
}
